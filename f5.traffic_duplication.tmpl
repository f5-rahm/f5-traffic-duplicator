cli admin-partitions {
    update-partition Common
}
sys application template /Common/f5.traffic_duplication {
    actions {
        definition {
            html-help {
                <p><b>TCP/UDP Packet Duplication Template (Modernized)</b></p>
<p>This template creates a complete implementation of Layer 4 UDP or TCP packet duplication.</p>
<ul>
  <li>Supports TMOS 17.5.x, 21.1.x, and Route Domains.</li>
  <li>Features high-performance High-Speed Logging (HSL) duplication.</li>
  <li>Allows primary, secondary, and tertiary failover destination servers.</li>
  <li>Full IPv4 and IPv6 dual-stack support.</li>
</ul>

<p><b>Virtual Server Questions</b></p>
<p><i>IP address</i><br />
Type the IP address clients will send traffic to. The system creates a virtual server using this address.</p>
<p><i>Port</i><br />
Type the associated service port (e.g., 514 for Syslog, 162 for SNMP Traps, or custom TCP/UDP ports).</p>
<p><i>Failover</i><br />
Allows automated health-checked failover within each destination group using priority groups.</p>
            }
            implementation {
###########################################################################
